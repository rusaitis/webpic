{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true,

    "paths": {
      "@schema": ["./src/schema/index.ts"],
      "@schema/*": ["./src/schema/*"],
      "@containers": ["./src/containers/index.ts"],
      "@containers/*": ["./src/containers/*"],
      "@coordinates": ["./src/coordinates/index.ts"],
      "@coordinates/*": ["./src/coordinates/*"],
      "@numerics": ["./src/numerics/index.ts"],
      "@numerics/*": ["./src/numerics/*"],
      "@reductions": ["./src/reductions/index.ts"],
      "@reductions/*": ["./src/reductions/*"],
      "@derived": ["./src/derived/index.ts"],
      "@derived/*": ["./src/derived/*"],
      "@diagnostics": ["./src/diagnostics/index.ts"],
      "@diagnostics/*": ["./src/diagnostics/*"],
      "@gpu": ["./src/gpu/index.ts"],
      "@gpu/*": ["./src/gpu/*"],
      "@shaders": ["./src/shaders/index.ts"],
      "@shaders/*": ["./src/shaders/*"],
      "@compute": ["./src/compute/index.ts"],
      "@compute/*": ["./src/compute/*"],
      "@data": ["./src/data/index.ts"],
      "@data/*": ["./src/data/*"],
      "@remote": ["./src/remote/index.ts"],
      "@remote/*": ["./src/remote/*"],
      "@render": ["./src/render/index.ts"],
      "@render/*": ["./src/render/*"],
      "@store": ["./src/store/index.ts"],
      "@store/*": ["./src/store/*"],
      "@ui": ["./src/ui/index.ts"],
      "@ui/*": ["./src/ui/*"],
      "@app": ["./src/app/index.ts"],
      "@app/*": ["./src/app/*"],
      "@workers": ["./src/workers/index.ts"],
      "@workers/*": ["./src/workers/*"],
      "@embed": ["./src/embed/index.ts"],
      "@embed/*": ["./src/embed/*"]
    }
  }
}
