{
  "name": "webpic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/WebGPU plasma-physics data visualizer + lightweight analyzer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "preview:lan": "vite preview --host --mode lan",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "gen:export": "uv run --project ../pypic pypic export bundle --inline-single-use-defs --include-x-extensions -o src/schema/pypic-export.generated.json",
    "gen:emit": "node scripts/codegen/emit.ts && biome format --write src/schema src/compute",
    "gen": "npm run gen:export && npm run gen:emit",
    "gen:check": "npm run gen:emit && git diff --exit-code -- src/schema src/compute",
    "gen:fixtures": "node scripts/gen-fixtures.ts",
    "gen:synthetic": "node scripts/gen-synthetic.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "test": "vitest run",
    "test:gpu": "WEBPIC_GPU=1 vitest run --project gpu",
    "perf:gate": "node scripts/perf-gate.ts",
    "format": "biome format --write ."
  },
  "dependencies": {
    "smol-toml": "^1.6.1",
    "three": "0.184.0",
    "zarrita": "^0.7.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@webgpu/types": "^0.1.70",
    "happy-dom": "^20.9.0",
    "json-schema-to-zod": "^2.8.1",
    "playwright-core": "^1.60.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
