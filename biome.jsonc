{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // Ratchets: each ceiling sits at today's worst value, so nothing new may be worse than the
      // worst thing already here. They only ever fall — lower them in the commit that splits the
      // offender. Targets: complexity 20, lines 150 (CLAUDE.md §Lifecycle & shape). A body that is
      // long or branchy *by construction* takes a biome-ignore naming that reason instead; six do —
      // four in src/, plus a browser probe and an instrument.
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 26 }
        },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 210 } }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        }
      },
      "style": {
        "noParameterAssign": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["three", "three/**"],
                "message": "three.js is render-only — no THREE.* outside src/render/ (see docs/DESIGN.md §Layered dependency DAG)."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/render/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // A test body is linear and reads top to bottom; length there is not the smell the rule is for.
      "includes": ["scripts/**", "tests/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["**/*.generated.ts"],
      "linter": { "enabled": false },
      "assist": { "actions": { "source": { "organizeImports": "off" } } }
    },
    {
      "includes": ["**/*.generated.json", "tests/fixtures/**/*.json"],
      "formatter": { "enabled": false }
    }
  ]
}
