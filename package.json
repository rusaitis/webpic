{
  "name": "webpic",
  "version": "0.1.1",
  "type": "module",
  "description": "TypeScript/WebGPU plasma-physics data visualizer + lightweight analyzer",
  "license": "MIT",
  "author": "Liutauras Rusaitis <liutauras.rusaitis@gmail.com>",
  "homepage": "https://rusaitis.github.io/webpic/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusaitis/webpic.git"
  },
  "bugs": {
    "url": "https://github.com/rusaitis/webpic/issues"
  },
  "keywords": [
    "plasma-physics",
    "particle-in-cell",
    "magnetohydrodynamics",
    "scientific-visualization",
    "webgpu",
    "volume-rendering",
    "field-lines",
    "zarr",
    "heliophysics",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "preview:lan": "vite preview --host --mode lan",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run typecheck && npm run check:boundaries && npm run lint:ci && npm run check:dead && npm run build && npm run build:embed && npm run test:coverage && npm run docs:api && npm run check:size",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:dead": "knip",
    "docs:api": "typedoc",
    "gen:export": "uv run --project ../pypic pypic export bundle --inline-single-use-defs --include-x-extensions -o src/schema/pypic-export.generated.json",
    "gen:emit": "node scripts/codegen/emit.ts && biome format --write src/schema src/compute",
    "gen": "npm run gen:export && npm run gen:emit",
    "gen:check": "npm run gen:emit && git diff --exit-code -- 'src/**/*.generated.ts'",
    "gen:themes": "node scripts/sync-themes.ts",
    "gen:themes:check": "npm run gen:themes && git diff --exit-code -- src/data/theme/themes",
    "gen:fixtures": "node scripts/gen-fixtures.ts",
    "gen:synthetic": "node scripts/gen-synthetic.ts",
    "gen:trace-fixtures": "node scripts/gen-trace-fixtures.ts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:parity": "WEBPIC_PYPIC_PARITY=1 vitest run",
    "test:gpu": "WEBPIC_GPU=1 vitest run --project gpu",
    "perf:gate": "node scripts/perf-gate.ts",
    "perf:raymarch": "node scripts/profile-raymarch.ts",
    "verify:streaming": "node scripts/verify-streaming-render.ts",
    "verify:orientation": "node scripts/verify-orientation.ts",
    "check:size": "size-limit",
    "shot:readme": "node scripts/shot-readme.ts",
    "format": "biome format --write .",
    "prepare": "lefthook install"
  },
  "size-limit": [
    {
      "name": "@webpic/embed (dist-embed/*.js, gzip)",
      "path": "dist-embed/*.js",
      "limit": "560 kB",
      "gzip": true
    },
    {
      "name": "app (dist/assets/*.js, gzip)",
      "path": "dist/assets/*.js",
      "limit": "420 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "smol-toml": "^1.6.1",
    "three": "0.185.1",
    "zarrita": "^0.7.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^25.9.1",
    "@types/three": "^0.185.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "happy-dom": "^20.14.3",
    "json-schema-to-zod": "^2.8.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "playwright-core": "^1.63.0",
    "size-limit": "^12.1.0",
    "ts-morph": "^28.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wgsl_reflect": "^1.6.0"
  },
  "packageManager": "npm@11.19.0"
}
