{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `scripts/**` and `tests/**` are entry points, so nothing in either tree can be reported unused —
  // a green check:dead is not evidence that there are no orphan scripts. tests/live-modules.test.ts
  // covers the src side of that blind spot (a module only its own test imports).
  "entry": [
    "src/render/worker.ts",
    "src/workers/*.worker.ts",
    "src/embed/index.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.test.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  // Every layer keeps an index.ts barrel so its @layer alias resolves (tests/aliases.test.ts);
  // a barrel with nothing left to re-export is slimmed, never deleted. `*.generated.ts` is NOT
  // ignored: an emitted export nothing imports means the generator itself produces dead code.
  "ignore": ["src/remote/index.ts", "src/shaders/index.ts", "src/workers/index.ts"],
  // `uv` runs the pypic sibling for golden/theme generation — never installed by this package.
  "ignoreBinaries": ["uv"],
  "vite": { "config": ["vite.config.ts", "vite.embed.config.ts"] }
}
